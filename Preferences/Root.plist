        { cell = PSSliderCell; defaults = "com.user.notchnowplaying"; key = LyricsSyncOffsetMilliseconds; label = "偏移（ms）"; default = 100; min = -500; max = 500; showValue = 1; PostNotification = "com.user.notchnowplaying.preferences.changed"; },

