        { cell = PSGroupCell; label = "鎖定畫面 AOD"; footerText = "開啟後，播放中的音樂可在鎖定後以黑底顯示播放器。此功能仍在實驗階段，也需要開啟「鎖定畫面顯示播放器」。請先解鎖手機並開始播放，再按側邊按鈕鎖定螢幕。"; },
        { cell = PSSwitchCell; defaults = "com.user.notchnowplaying"; key = ExperimentalLockedVisible; label = "啟用實驗性 AOD 播放器"; default = 0; PostNotification = "com.user.notchnowplaying.preferences.changed"; },
        { cell = PSGroupCell; label = "AOD 通知提醒"; footerText = "只在鎖定且 AOD 顯示時生效。通知到達時，光點會從瀏海旁沿螢幕邊緣繞行兩圈，並短暫顯示 App 圖示和通知內容。收到的通知 App 圖示會列在專輯封面下方，最多顯示 3 個，更多以「+N」表示；解鎖或離開 AOD 後清除。通知仍保留在系統通知中心。減少動態效果開啟時改用靜態邊框提示。側鍵喚醒維持原行為。此功能預設關閉。"; },
        { cell = PSSwitchCell; defaults = "com.user.notchnowplaying"; key = NotificationSnakeWakeEnabled; label = "蛇形動畫顯示通知"; default = 0; PostNotification = "com.user.notchnowplaying.preferences.changed"; },

        { cell = PSGroupCell; label = "播放器位置微移"; footerText = "每 30 秒隨機微移播放器內容，水平與垂直方向各不超過 3 個螢幕像素，以降低 OLED 長時間顯示固定圖樣造成烙印的風險；無法保證完全避免。"; },
        { cell = PSSwitchCell; defaults = "com.user.notchnowplaying"; key = AODPixelShiftEnabled; label = "微移播放器內容"; default = 1; PostNotification = "com.user.notchnowplaying.preferences.changed"; },

        { cell = PSGroupCell; label = "AOD 亮度"; footerText = "100% 保持原本亮度；提高後會在 AOD 期間調整面板亮度，400% 約為 120 nits。喚醒、解鎖或顯示時間結束時會還原。亮度越高耗電越多。"; },
        { cell = PSSliderCell; defaults = "com.user.notchnowplaying"; key = AODBrightnessMultiplier; label = "亮度（%）"; default = 100; min = 100; max = 400; showValue = 1; PostNotification = "com.user.notchnowplaying.preferences.changed"; },

        { cell = PSGroupCell; label = "AOD 顯示時間"; footerText = "開啟後，音樂持續播放時不受下方時間上限限制。解鎖或關閉功能會結束 AOD；音樂停止約 15 秒後也會結束。"; },
        { cell = PSSwitchCell; defaults = "com.user.notchnowplaying"; key = ExperimentalUnlimitedDuration; label = "持續顯示（不限時）"; default = 0; PostNotification = "com.user.notchnowplaying.preferences.changed"; },
        { cell = PSGroupCell; label = "AOD 時間上限"; footerText = "只有關閉「持續顯示」時才使用。預設 30 秒，範圍 5 至 60 秒。調整時間後，下次進入 AOD 時生效。"; },
        { cell = PSSliderCell; defaults = "com.user.notchnowplaying"; key = ExperimentalMaxDuration; label = "時間（秒）"; default = 30; min = 5; max = 60; showValue = 1; PostNotification = "com.user.notchnowplaying.preferences.changed"; },

        { cell = PSGroupCell; label = "診斷資料"; footerText = "插件會在手機本機儲存執行紀錄，用於排查問題。通知喚醒追蹤只記錄來源 App、鎖定／AOD 狀態和背光來源，不記錄通知內容；測試結束後請關閉。"; },
        { cell = PSSwitchCell; defaults = "com.user.notchnowplaying"; key = NotificationWakeTraceEnabled; label = "記錄通知喚醒事件"; default = 0; PostNotification = "com.user.notchnowplaying.preferences.changed"; }
    );
