        { cell = PSSliderCell; defaults = "com.user.notchnowplaying"; key = ArtworkSize; label = "大小（pt）"; default = 40; min = 28; max = 56; showValue = 1; PostNotification = "com.user.notchnowplaying.preferences.changed"; },

