			<true/>
			<key>defaults</key>
			<string>com.user.notchnowplaying</string>
			<key>key</key>
			<string>ChargingAnimationEnabled</string>
			<key>label</key>
			<string>充電流光</string>
			<key>symbol</key>
			<string>bolt.fill</string>
			<key>tint</key>
			<string>orange</string>
