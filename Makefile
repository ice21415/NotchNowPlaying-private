ifneq ($(filter 1,$(NNP_ENABLE_PHASE4A_READONLY_BACKLIGHT_LOG) $(NNP_COMPILE_PHASE4A_DIAGNOSTIC) $(NNP_PHASE4A_UI_STATE_PROBE) $(NNP_PHASE4A_DELAYED_CFPREFERENCES_TEST) $(NNP_PHASE4A_DELAYED_TRACE_PROBE)),)
